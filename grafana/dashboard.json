      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "取樣間隔分布",
          "description": "每一次取樣與前一次的間隔，依毫秒分組統計。看的是分布的形狀，不是平均值——平均值看不見雙峰。\n\n目前資料：readings_20260921_wired_acceptance.db（樹莓派 + 有線直連，2026-09-21，8.06 小時 / 29,022 筆 / 讀取失敗 0）",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "frser-sqlite-datasource",
                      "version": "v0",
                      "spec": {
                        "queryText": "SELECT ROUND(gap * 1000) AS ms, COUNT(*) AS n FROM (\n  SELECT ts - LAG(ts) OVER (ORDER BY ts) AS gap FROM reading\n) WHERE gap IS NOT NULL\nGROUP BY ms ORDER BY ms",
                        "queryType": "table",
                        "rawQueryText": "SELECT ROUND(gap * 1000) AS ms, COUNT(*) AS n FROM (\n  SELECT ts - LAG(ts) OVER (ORDER BY ts) AS gap FROM reading\n) WHERE gap IS NOT NULL\nGROUP BY ms ORDER BY ms",
                        "timeColumns": []
                      },
                      "labels": {
