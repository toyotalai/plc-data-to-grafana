[Unit]
Description=PLC data collector (Modbus TCP -> SQLite)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=inform
WorkingDirectory=/home/inform/plc-data-to-grafana
Environment=PLC_HOST=192.168.50.1
Environment=PLC_PORT=5020
Environment=PYTHONUNBUFFERED=1
Environment=DATA_DIR=/var/lib/plc-gateway
ExecStart=/bin/bash -c 'ts=$(date +%%Y%%m%%d_%%H%%M%%S); exec env DB_PATH="$DATA_DIR/readings_$ts.db" /home/inform/plc-data-to-grafana/.venv/bin/python collect.py >> "$DATA_DIR/log_$ts.txt" 2>&1'
UMask=0027
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
