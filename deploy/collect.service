[Unit]
Description=PLC data collector (Modbus TCP + RTU -> SQLite)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=inform
WorkingDirectory=/home/inform/plc-data-to-grafana
Environment=PYTHONUNBUFFERED=1
Environment=DATA_DIR=/var/lib/plc-gateway
ExecStart=/bin/bash -c 'ts=$(date +%%Y%%m%%d_%%H%%M%%S); db="$DATA_DIR/readings_$ts.db"; ln -sfn "$db" "$DATA_DIR/current.db"; exec env DB_PATH="$db" /home/inform/plc-data-to-grafana/.venv/bin/python collect.py >> "$DATA_DIR/log_$ts.txt" 2>&1'
UMask=0027
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
